{
  "manifest_version": 3,
  "name": "Enhanced QIS LUH",
  "version": "1.1.1",
  "description": "Enhancements for the QIS grades portal of Leibniz Universität Hannover.",

  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "enhanced-qis-luh@local.addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },

  "content_scripts": [
    {
      "matches": [
        "*://qis.verwaltung.uni-hannover.de/*"
      ],
      "js": [
        "index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
